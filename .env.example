# Resend (https://resend.com) — necessário para o formulário de contato enviar e-mails
RESEND_API_KEY=

# Endereço remetente. Precisa ser um domínio verificado no Resend em produção;
# use "onboarding@resend.dev" apenas para testes.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Endereço que recebe as mensagens do formulário de contato
CONTACT_TO_EMAIL=baldassosamuel93@gmail.com

# Opcional: Personal Access Token do GitHub (sem escopos, apenas leitura pública)
# para evitar rate limit ao buscar os repositórios em build/revalidate
GITHUB_TOKEN=
